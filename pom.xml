<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.phenix</groupId>
    <artifactId>comparemd5</artifactId>
    <version>0.6.9</version>
    <packaging>jar</packaging>
    
    <name>CompareMD5</name>
    <description>Programme qui fait des copies avec vérification MD5.</description>
    <url>https://github.com/edouard333/CompareMD5</url>
    
    <developers>
        <developer>
            <name>Edouard Jeanjean</name>
            <email>edouard128@hotmail.com</email>
            <url>https://github.com/edouard333</url>
        </developer>
    </developers>
    
    <build>
        <!-- Nom du JAR par défaut. -->
        <finalName>${project.name}-${project.version}</finalName>
        
        <plugins>
            <!-- Fait des vérifications sur le projet. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>enforce-files-exist</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <!-- Vérifie qu'on utilise la bonne version de JDK. -->
                                <requireJavaVersion>
                                    <version>25</version>
                                </requireJavaVersion>
                                <!-- Vérifie qu'est indiqué le mode d'encodage des sources. -->
                                <requireProperty>
                                    <property>project.build.sourceEncoding</property>
                                    <regex>^(UTF-8)$</regex>
                                    <message>Le sourceEncoding doit être renseigné.</message>
                                    <regexMessage>Le sourceEncoding doit être "UTF-8".</regexMessage>
                                </requireProperty>
                                <!-- Vérifie qu'est indiqué la version du JDK pour la compilation. -->
                                <requireProperty>
                                    <property>maven.compiler.release</property>
                                    <regex>^(25)$</regex>
                                    <message>La version du JDK (compiler.release) doit être 25.</message>
                                </requireProperty>
                                <!-- Vérifie qu'il y a les scripts. -->
                                <requireFilesExist>
                                    <files>
                                        <file>src/main/distribution/run.bat</file>
                                        <file>src/main/distribution/run.sh</file>
                                    </files>
                                </requireFilesExist>
                                <!-- Vérifie qu'il y a le fichier "pom.properties". -->
                                <requireFilesExist>
                                    <files>
                                        <file>src/main/filters/pom.properties</file>
                                    </files>
                                </requireFilesExist>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            
            <!-- Analyse la qualité du code et fait un rapport. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                
                <dependencies>
                    <!-- Version de Checkstyle. -->
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>10.12.3</version>
                    </dependency>
                </dependencies>
                
                <configuration>
                    <configLocation>checkstyle.xml</configLocation>
                    <consoleOutput>false</consoleOutput>
                    <!-- On ne veut pas arrêter le build pour une violation de standard. -->
                    <failOnViolation>false</failOnViolation>
                    <failsOnError>false</failsOnError>
                    <linkXRef>false</linkXRef>
                    <!-- CheckStyle n'arrive pas à décoder les "module-info.java". -->
                    <excludes>
                        **/module-info.java
                    </excludes>
                </configuration>

                <executions>
                    <execution>
                        <id>checkstyle</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            
            <!-- Copie des fichiers et filtre si nécessaire. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <!-- Copie et filtre des fichiers. -->
                    <execution>
                        <id>copy-filtering-script</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <resources>
                                <resource>
                                    <directory>src/main/distribution</directory>
                                    <includes>
                                        <include>run.bat</include>
                                        <include>run.sh</include>
                                    </includes>
                                    <filtering>true</filtering>
                                </resource>
                            </resources>
                            <outputDirectory>${project.build.directory}/resources/${project.version}</outputDirectory>
                        </configuration>
                    </execution>
                    <!-- Copie et filtre le fichier "pom.properties" (pour n'avoir que les properties dont on a besoin). -->
                    <execution>
                        <id>copy-filtering-properties</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <resources>
                                <resource>
                                    <directory>src/main/filters</directory>
                                    <includes>
                                        <include>pom.properties</include>
                                    </includes>
                                    <filtering>true</filtering>
                                </resource>
                            </resources>
                            <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            
            <!-- Crée un assemblage (JAR ou dossier). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.8.0</version>
                <executions>
                    <!-- Permet d'ajouter les JAR externes au JAR créé. -->
                    <execution>
                        <id>jar-with-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptorRefs>
                                <descriptorRef>jar-with-dependencies</descriptorRef>
                            </descriptorRefs>
                            <archive>
                                <!-- Définit le main dans le JAR. -->
                                <manifest>
                                    <mainClass>${exec.mainClass}</mainClass>
                                </manifest>
                            </archive>
                            <!-- On n'ajoute pas l'ID de l'assembly dans le nom du JAR. -->
                            <appendAssemblyId>false</appendAssemblyId>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                        </configuration>
                    </execution>
                    <!-- Fait le package final du programme. -->
                    <execution>
                        <id>make-distribution</id>
                        <phase>install</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        
                        <configuration>
                            <descriptors>
                                <!-- On utilise l'XML d'assemblage dont on a besoin. -->
                                <descriptor>src/assembly/distribution.xml</descriptor>
                            </descriptors>
                            <!-- Le nom d'assembly est le numéro de version. -->
                            <finalName>${project.version}</finalName>
                            <!-- On n'ajoute pas l'ID de l'assembly (XML) dans le nom de l'assembly. -->
                            <appendAssemblyId>false</appendAssemblyId>
                            <!-- L'assemblage, on met dans le dossier "build". -->
                            <outputDirectory>${project.build.directory}/build</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            
            <!-- Converti le README markdown en PDF. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                
                <dependencies>
                    <!-- Permet de convertir un markdown en PDF, ici que pour le README, donc que pour la compilation. -->
                    <dependency>
                        <groupId>com.phenix</groupId>
                        <artifactId>markdowntopdf</artifactId>
                        <version>0.1.3</version>
                    </dependency>
                </dependencies>
                
                <executions>
                    <execution>
                        <id>markdown-to-pdf</id>
                        <phase>package</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.phenix.markdowntopdf.MarkdownToPdf</mainClass>
                            <includePluginDependencies>true</includePluginDependencies>
                            <classpathScope>compile</classpathScope>
                            <arguments>
                                <argument>${project.basedir}/README.md</argument>
                                <argument>${project.build.directory}/resources/${project.version}/README.pdf</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            
            <!-- Génère des checksums. -->
            <plugin>
                <groupId>net.nicoulaj.maven.plugins</groupId>
                <artifactId>checksum-maven-plugin</artifactId>
                <version>1.11</version>
                <executions>
                    <execution>
                        <id>checksum-package</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>files</goal>
                        </goals>
                        <configuration>
                            <fileSets>
                                <!-- Inclure les fichiers de build Maven. -->
                                <fileSet>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>${project.build.finalName}.jar</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                            <individualFilesOutputDirectory>resources/${project.version}</individualFilesOutputDirectory>
                            <csvSummaryFile>resources/${project.version}/checksums-${project.version}.csv</csvSummaryFile>
                            <!-- L'algorithme de hash. -->
                            <algorithms>
                                <algorithm>SHA-1</algorithm>
                                <algorithm>MD5</algorithm>
                            </algorithms>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            
            <!-- N'ajoute pas le projet dans le repository Maven en local. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>3.1.4</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
    
    <dependencies>
        <dependency>
            <groupId>com.phenix</groupId>
            <artifactId>swing</artifactId>
            <version>0.6.8</version>
        </dependency>
        <!-- Ajout des annotations @NotNull, etc. -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>3.1.1</version>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.51.1.0</version>
        </dependency>
    </dependencies>
    
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <exec.mainClass>${project.groupId}.${project.artifactId}.Main</exec.mainClass>
    </properties>
</project>